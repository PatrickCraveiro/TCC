# Conexão com o MongoDB.
# Local (npm run db:dev): mongodb://127.0.0.1:27017/medquery
# Atlas (produção):        mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/medquery?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/medquery

# Segredo que assina o cookie de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Opcional: senhas dos usuários criados pelo seed (padrão: admin123 / paciente123).
# SEED_ADMIN_SENHA=
# SEED_PACIENTE_SENHA=
